@{
    ViewData["Title"] = "Home";
}

<!-- Header with background image -->
<section class="home-header">
    <div class="header-content">
        <h1>Welcome to CinemaApp</h1>
        <p>Discover movies and enjoy the magic of cinema.</p>
    </div>
</section>
<!-- Movies section -->
<div class="container home-content">

    <h2>Featured Movies</h2>

    <div class="row">

        <div class="col-md-6">
            <div class="simple-movie">
                <h3>Interstellar</h3>
                <p>Genre: Sci-Fi / Adventure</p>
                <p>Experience an incredible journey beyond the stars.</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="simple-movie">
                <h3>Oppenheimer</h3>
                <p>Genre: Drama / History</p>
                <p>The story of the creation of the atomic bomb.</p>
            </div>
        </div>

    </div>

</div>
